<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="io.sc.eppCordova.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="io.sc.eppCordova.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_otp"
            app:destination="@id/otpFragment" />
    </fragment>

    <fragment
        android:id="@+id/otpFragment"
        android:name="io.sc.eppCordova.ui.auth.OtpFragment"
        android:label="OTP"
        tools:layout="@layout/fragment_otp">
        <action
            android:id="@+id/action_otp_to_adminUnit"
            app:destination="@id/adminUnitFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/adminUnitFragment"
        android:name="io.sc.eppCordova.ui.location.AdminUnitFragment"
        android:label="Admin Unit"
        tools:layout="@layout/fragment_admin_unit">
        <action
            android:id="@+id/action_adminUnit_to_parcel"
            app:destination="@id/parcelFragment" />
    </fragment>

    <fragment
        android:id="@+id/parcelFragment"
        android:name="io.sc.eppCordova.ui.land.ParcelFragment"
        android:label="Parcel"
        tools:layout="@layout/fragment_parcel">
        <action
            android:id="@+id/action_parcel_to_landRecord"
            app:destination="@id/landRecordFragment" />
    </fragment>

    <fragment
        android:id="@+id/landRecordFragment"
        android:name="io.sc.eppCordova.ui.land.LandRecordFragment"
        android:label="Land Record"
        tools:layout="@layout/fragment_land_record">
        <action
            android:id="@+id/action_landRecord_to_cropForm"
            app:destination="@id/cropFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/cropFormFragment"
        android:name="io.sc.eppCordova.ui.crop.CropFormFragment"
        android:label="Crop Form"
        tools:layout="@layout/fragment_crop_form">
        <action
            android:id="@+id/action_cropForm_to_gpsPhoto"
            app:destination="@id/gpsPhotoFragment" />
    </fragment>

    <fragment
        android:id="@+id/gpsPhotoFragment"
        android:name="io.sc.eppCordova.ui.geotag.GpsPhotoFragment"
        android:label="GPS and Photo"
        tools:layout="@layout/fragment_gps_photo">
        <action
            android:id="@+id/action_gpsPhoto_to_review"
            app:destination="@id/reviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/reviewFragment"
        android:name="io.sc.eppCordova.ui.review.ReviewFragment"
        android:label="Review"
        tools:layout="@layout/fragment_review">
        <action
            android:id="@+id/action_review_to_success"
            app:destination="@id/successFragment"
            app:popUpTo="@id/parcelFragment" />
    </fragment>

    <fragment
        android:id="@+id/successFragment"
        android:name="io.sc.eppCordova.ui.review.SuccessFragment"
        android:label="Success"
        tools:layout="@layout/fragment_success">
        <action
            android:id="@+id/action_success_to_adminUnit"
            app:destination="@id/adminUnitFragment"
            app:popUpTo="@id/adminUnitFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>

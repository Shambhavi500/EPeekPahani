<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="io.sc.eppCordova.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_language"
            app:destination="@id/languageFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/languageFragment"
        android:name="io.sc.eppCordova.ui.language.LanguageFragment"
        android:label="Language"
        tools:layout="@layout/fragment_language">
        <action
            android:id="@+id/action_language_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/languageFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="io.sc.eppCordova.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_otp"
            app:destination="@id/otpFragment" />
    </fragment>

    <fragment
        android:id="@+id/otpFragment"
        android:name="io.sc.eppCordova.ui.auth.OtpFragment"
        android:label="OTP"
        tools:layout="@layout/fragment_otp">
        <action
            android:id="@+id/action_otp_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="io.sc.eppCordova.ui.home.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboard_to_lossClaim"
            app:destination="@id/lossClaimStep1Fragment" />
        <action
            android:id="@+id/action_dashboard_to_profile"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_dashboard_to_syncStatus"
            app:destination="@id/syncStatusFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="io.sc.eppCordova.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/syncStatusFragment"
        android:name="io.sc.eppCordova.ui.sync.SyncStatusFragment"
        android:label="Sync Status"
        tools:layout="@layout/fragment_sync_status" />

    <fragment
        android:id="@+id/lossClaimStep1Fragment"
        android:name="io.sc.eppCordova.ui.lossclaim.LossClaimStep1Fragment"
        android:label="Loss Claim Step 1"
        tools:layout="@layout/fragment_loss_claim_step1">
        <action
            android:id="@+id/action_lossClaimStep1_to_lossClaimStep2"
            app:destination="@id/lossClaimStep2Fragment" />
    </fragment>

    <fragment
        android:id="@+id/lossClaimStep2Fragment"
        android:name="io.sc.eppCordova.ui.lossclaim.LossClaimStep2Fragment"
        android:label="Loss Claim Step 2"
        tools:layout="@layout/fragment_loss_claim_step2">
        <action
            android:id="@+id/action_lossClaimStep2_to_lossClaimStep3"
            app:destination="@id/lossClaimStep3Fragment" />
    </fragment>

    <fragment
        android:id="@+id/lossClaimStep3Fragment"
        android:name="io.sc.eppCordova.ui.lossclaim.LossClaimStep3Fragment"
        android:label="Loss Claim Step 3"
        tools:layout="@layout/fragment_loss_claim_step3">
        <action
            android:id="@+id/action_lossClaimStep3_to_lossClaimStep4"
            app:destination="@id/lossClaimStep4Fragment" />
    </fragment>

    <fragment
        android:id="@+id/lossClaimStep4Fragment"
        android:name="io.sc.eppCordova.ui.lossclaim.LossClaimStep4Fragment"
        android:label="Loss Claim Step 4"
        tools:layout="@layout/fragment_loss_claim_step4">
        <action
            android:id="@+id/action_lossClaimStep4_to_lossClaimStep5"
            app:destination="@id/lossClaimStep5Fragment" />
        <action
            android:id="@+id/action_lossClaimStep4_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/lossClaimStep5Fragment"
        android:name="io.sc.eppCordova.ui.lossclaim.LossClaimStep5Fragment"
        android:label="Loss Claim Step 5"
        tools:layout="@layout/fragment_loss_claim_step5">
        <action
            android:id="@+id/action_lossClaimStep5_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_lossClaimStep5_to_myClaims"
            app:destination="@id/myClaimsFragment" />
    </fragment>

    <fragment
        android:id="@+id/myClaimsFragment"
        android:name="io.sc.eppCordova.ui.myclaims.MyClaimsFragment"
        android:label="My Claims"
        tools:layout="@layout/fragment_my_claims">
        <action
            android:id="@+id/action_myClaims_to_claimDetail"
            app:destination="@id/claimDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/claimDetailFragment"
        android:name="io.sc.eppCordova.ui.myclaims.ClaimDetailFragment"
        android:label="Claim Detail"
        tools:layout="@layout/fragment_claim_detail" />

    <fragment
        android:id="@+id/certificateFragment"
        android:name="io.sc.eppCordova.ui.certificate.CertificateFragment"
        android:label="Certificate"
        tools:layout="@layout/fragment_certificate">
    </fragment>

</navigation>

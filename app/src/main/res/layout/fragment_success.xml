<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:gravity="center">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <!-- Success Icon -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_circle_primary_container"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_check_circle"
                    app:tint="@color/on_primary_container"
                    android:contentDescription="Success" />
            </FrameLayout>

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_auto_183"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_auto_184"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Reference ID -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/surface_container_high"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_auto_185"
                    android:textColor="@color/secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_reference_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_auto_186"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Certificate Preview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Header Row: Gov logo + QR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:srcCompat="@drawable/ic_maharashtra_emblem"
                                android:scaleType="fitCenter"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="Government Logo" />

                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_auto_84" android:textColor="@color/on_surface" android:textSize="14sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_auto_187" android:textColor="@color/on_surface_variant" android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iv_qr_code"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:srcCompat="@drawable/ic_qr_placeholder"
                            android:scaleType="fitXY"
                            android:contentDescription="QR Code" />
                    </LinearLayout>

                    <!-- Certificate Title -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/str_auto_188"
                        android:textColor="@color/primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Details Grid -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_auto_189" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tv_cert_farmer_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_auto_190" android:textColor="@color/on_surface" android:textSize="14sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_auto_9" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tv_cert_gat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_auto_191" android:textColor="@color/on_surface" android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_auto_192" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tv_cert_crop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_auto_193" android:textColor="@color/on_surface" android:textSize="14sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_auto_194" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tv_cert_season" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_auto_195" android:textColor="@color/on_surface" android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Verified Badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_verified_green"
                        android:padding="8dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" app:srcCompat="@drawable/ic_verified" app:tint="#2E7D32" android:layout_marginEnd="6dp" android:contentDescription="Verified" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_auto_196" android:textColor="#2E7D32" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_certificate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/str_auto_197"
                android:textSize="16sp"
                app:backgroundTint="@color/primary"
                android:textColor="@color/on_primary"
                app:icon="@drawable/ic_description"
                app:iconGravity="start"
                app:cornerRadius="12dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_new_gat_registration"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/str_auto_198"
                android:textSize="16sp"
                app:backgroundTint="@android:color/transparent"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:strokeWidth="2dp"
                app:icon="@drawable/ic_add_circle"
                app:iconGravity="start"
                app:cornerRadius="12dp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/green_primary"
        app:cardElevation="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"
        app:cardCornerRadius="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="40dp"> <!-- Assuming 24dp for WindowInsets -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_farmer_avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/sym_def_app_icon"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/text_white"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_farmer_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="शेतकरी नाव"
                        android:textColor="@color/text_white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="जिल्हा | तालुका | गाव"
                        android:textColor="#BFFFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="खरीप 2025"
                    app:chipBackgroundColor="@color/saffron"
                    android:textColor="@color/text_white"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="नोंदणी: 1 जुलै – 31 ऑगस्ट 2025"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="सुरू"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="@color/green_light"
                    android:textColor="@color/green_light"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_popup_sync"
                    app:tint="@color/text_white" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="शेवटची sync: 5 मिनिटांपूर्वी"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp"/>
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sync करा"
                    android:textColor="@color/text_white"
                    android:textSize="11sp"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <include
        android:id="@+id/offline_banner"
        layout="@layout/offline_banner" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_new_crop"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_wheat" app:tint="@color/green_primary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="नवीन नोंदणी" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_certificate"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_certificate" app:tint="@color/navy"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="प्रमाणपत्र" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_claim"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_alert_farm" app:tint="@color/saffron"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="नुकसान" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="माझे गट नंबर"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>
        <TextView
            android:id="@+id/tv_gat_count"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/shape_circle_green"
            android:text="3"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginStart="8dp"/>
        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="सर्व पाहा"
            android:textColor="@color/green_primary"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_gats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
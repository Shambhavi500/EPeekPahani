<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@color/surface_container_low">

    <TextView
        android:id="@+id/tv_step1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="@string/str_auto_216"
        android:textColor="@color/on_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_step_active" />

    <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="@color/outline_variant" />

    <TextView
        android:id="@+id/tv_step2"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="@string/str_auto_217"
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_step_inactive" />

    <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="@color/outline_variant" />

    <TextView
        android:id="@+id/tv_step3"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="@string/str_auto_218"
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_step_inactive" />

    <View android:layout_width="0dp" android:layout_height="2dp" android:layout_weight="1" android:background="@color/outline_variant" />

    <TextView
        android:id="@+id/tv_step4"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="@string/str_auto_219"
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_step_inactive" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_offline_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    app:cardBackgroundColor="@color/offline_bg"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="4dp"
    app:strokeColor="@color/offline_text">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📵"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tv_offline_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ऑफलाइन — X नोंदी sync बाकी"
            android:textColor="@color/offline_text"
            android:textSize="13sp"
            android:layout_marginStart="8dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sync करा"
            android:textColor="@color/offline_text" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
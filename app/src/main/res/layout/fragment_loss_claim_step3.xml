<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/online_mode_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1C1C1C"
        android:visibility="visible">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/green_primary"
                android:padding="12dp"
                android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/str_auto_108" android:textColor="@color/text_white" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
            
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_ai_chat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp"
                android:clipToPadding="false"/>
                
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <androidx.camera.view.PreviewView
                        android:id="@+id/camera_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_margin="16dp">
                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/shape_circle_red" /> <!-- You can reuse red shape -->
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_auto_109" android:textColor="@color/error" android:textStyle="bold" android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    
                    <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@android:drawable/ic_dialog_map" android:background="#B3FFFFFF" android:layout_gravity="top|end" android:layout_margin="16dp"/>
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_auto_110" android:textColor="@color/text_white" android:textSize="24sp" android:textStyle="bold" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="24dp"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#1C1C1C"
                android:padding="16dp"
                android:gravity="center">
                
                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:id="@+id/btn_record_online"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_auto_111"
                    android:textColor="@color/text_white"
                    app:backgroundTint="@color/error"/>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progress="50"
                app:indicatorColor="@color/green_primary"
                app:trackColor="#4DFFFFFF" />
                
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next_online"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:enabled="false"
                android:text="@string/str_auto_107" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/offline_mode_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_screen"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_auto_112"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="12dp"
                android:background="@color/saffron"/>
                
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewpager_steps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_prev_offline"
                    style="@style/Widget.App.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/str_auto_113" />
                    
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_next_offline"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:enabled="false"
                    android:text="@string/str_auto_107" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>